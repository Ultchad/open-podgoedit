{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POD Go Editor",
  "version": "0.1.0",
  "identifier": "io.github.ultchad.openpodgoedit",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "POD Go Editor",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Unofficial POD Go preset editor",
    "icon": ["icons/icon.png"]
  }
}
